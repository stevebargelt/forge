{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "noEmit": true,
    "isolatedModules": true,
    "lib": ["ES2022", "DOM"],
    "baseUrl": ".",
    "paths": {
      "@forge/types": ["../src/types/index.ts"],
      "@forge/project-meta": ["../src/util/project-meta.ts"],
      "@forge/projects": ["../src/util/projects.ts"],
      "@forge/heartbeats": ["../src/util/orchestrator-heartbeats.ts"],
      "@forge/governance": ["../src/raci/governance.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
