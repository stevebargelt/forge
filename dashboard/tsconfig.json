{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "allowJs": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "noEmit": true,
    "isolatedModules": true,
    "lib": ["ES2022", "DOM"],
    "baseUrl": ".",
    "paths": {
      "@forge/types": ["../src/types/index.ts"],
      "@forge/project-meta": ["../src/util/project-meta.ts"],
      "@forge/projects": ["../src/util/projects.ts"],
      "@forge/repository-identity": ["../src/util/repository-identity.ts"],
      "@forge/heartbeats": ["../src/util/orchestrator-heartbeats.ts"],
      "@forge/orchestrator-receipts": ["../src/store/orchestrator-receipts.ts"],
      "@forge/orchestrator-credential": ["../src/orchestrator/claude-session-state.ts"],
      "@forge/governance": ["../src/raci/governance.ts"],
      "@forge/reconcile-candidate": ["../src/ops/reconcile-candidate.ts"],
      "@forge/backlog": ["../src/backlog/structured.ts"],
      "@forge/backlog-config": ["../src/backlog/config.ts"],
      "@forge/blocked-source": ["../src/store/blocked-source.ts"],
      "@forge/current-activity": ["../src/v2/current-activity.ts"],
      "@forge/launch-observations": ["../src/store/launch-observations.ts"]
    }
  },
  "include": ["src/**/*.ts", "browser-tests/**/*.ts"]
}
