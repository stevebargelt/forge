  2. manifest.runtime      : name=codex-subscription  kind=codex          logFormat=codex-jsonl
  3. manifest.model        : profile=codex-subscription  runtime=codex-subscription  resolvedBy=cli.--profile
  4. controlPlane.runtime  : name=codex-subscription  source=host  path=~/.forge/runtimes/codex-subscription.yml
  5. log-format signature  : container.stdout.log line 1 = {"type":"thread.started","thread_id":"019f66ee-..."}   (codex-jsonl)
