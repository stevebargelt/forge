#!/usr/bin/env bash
# commit-msg hook — refuse commits that attribute work to an AI assistant.
# Defense-in-depth for the no-ai-attribution force-level constraint.
#
# Installed by `forge init` into <project>/.git/hooks/commit-msg.
# Bypass with `git commit --no-verify` only when you genuinely need to
# reference an AI assistant in a commit (rare).
#
# FG-799: this hook is per-project TOGGLEABLE. If <repo-root>/.forge/config.yml
# sets `ai_attribution: allow` the hook exits 0 silently (attribution is fine in
# that project). Absent or `suppress` → enforce. The mode is read by ONE parser
# shared with the TypeScript reader (see below) — never a bash grep of the YAML.
#
# Patterns rejected under suppress (case-insensitive), widened to every assistant
# forge runs (Claude/Anthropic, Codex/OpenAI/ChatGPT, Gemini, Copilot):
#   - "Co-Authored-By:" lines naming claude|anthropic|codex|openai|chatgpt|gemini|copilot
#   - "Generated with <tool>" boilerplate and any "🤖 …" attribution line
#   - Any bare mention of "Claude", "Anthropic", "Codex", "OpenAI", "ChatGPT",
#     "Gemini", or "Copilot"
#
# Exit 0 = commit proceeds. Exit nonzero = commit blocked.

set -eu

MSG_FILE="$1"

# FG-799: per-project allow toggle. The mode is decided by ONE parser — the
# standalone reader that sits right next to this hook — never a bash grep of the
# YAML. A grep and the TypeScript reader (src/v2/ai-attribution.ts) cannot be kept
# in agreement at the edges (a root key with leading indentation, a mismatched
# quote); the reader IS that parser's other caller, so hook and reader now read the
# same mode by construction.
#
# The reader sits alongside this hook in BOTH shapes it ships in: reached through the
# promoted release (this file is a symlink installed by `forge init`; resolve the real
# path and the reader is its sibling), or copied as bytes into a provisioned
# workspace's .git/hooks next to the hook copy (src/util/commit-msg-hook.ts). So it is
# found as a sibling of this hook's REAL path in either case.
#
# Fail closed and VISIBLE: if node is missing or the reader cannot be found/run, treat
# the mode as suppress and print one stderr notice naming why — a broken toolchain must
# never read as silently permissive.

# Resolve this hook's own real path (walk the symlink chain; readlink -f is not on
# stock macOS), then take the directory it lives in.
resolve_hook_dir() {
  local src="$1" dir
  while [ -h "$src" ]; do
    dir="$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)"
    src="$(readlink "$src")"
    case "$src" in
      /*) ;;
      *) src="$dir/$src" ;;
    esac
  done
  cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd
}

HOOK_DIR="$(resolve_hook_dir "${BASH_SOURCE[0]}")"
READER="$HOOK_DIR/read-ai-attribution.mjs"
ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"

AI_MODE="suppress"
if [ -n "$ROOT" ]; then
  if ! command -v node >/dev/null 2>&1; then
    printf '\033[33mnote:\033[0m no-ai-attribution hook: node not found — enforcing suppress (could not read ai_attribution).\n' >&2
  elif [ ! -f "$READER" ]; then
    printf '\033[33mnote:\033[0m no-ai-attribution hook: reader missing at %s — enforcing suppress.\n' "$READER" >&2
  else
    READER_OUT="$(node "$READER" "$ROOT" 2>/dev/null || true)"
    case "$READER_OUT" in
      allow) AI_MODE="allow" ;;
      suppress) AI_MODE="suppress" ;;
      *) printf '\033[33mnote:\033[0m no-ai-attribution hook: reader gave unexpected output %s — enforcing suppress.\n' "${READER_OUT:-<empty>}" >&2 ;;
    esac
  fi
fi

if [ "$AI_MODE" = "allow" ]; then
  exit 0
fi

if grep -qiE '^[[:space:]]*Co-Authored-By:.*(claude|anthropic|codex|openai|chatgpt|gemini|copilot)' "$MSG_FILE"; then
  printf '\033[31m✗ commit blocked:\033[0m commit message contains a "Co-Authored-By: <AI assistant>" trailer.\n' >&2
  printf '  See seeds/constraints/no-ai-attribution.md.\n' >&2
  printf '  To bypass: git commit --no-verify  (rare; only when the reference is intentional)\n' >&2
  exit 1
fi

if grep -qiE 'generated with (claude code|codex|chatgpt|copilot|gemini)|🤖' "$MSG_FILE"; then
  printf '\033[31m✗ commit blocked:\033[0m commit message contains AI-attribution boilerplate.\n' >&2
  printf '  See seeds/constraints/no-ai-attribution.md.\n' >&2
  printf '  To bypass: git commit --no-verify\n' >&2
  exit 1
fi

# Bare mentions of Claude / Anthropic / Codex / OpenAI / ChatGPT in body or title.
# Strip comment lines (git's own diff annotations) AND strip well-known technical
# identifiers that legitimately contain the banned words:
#   - CLAUDE.md (canonical project-setup filename)
#   - CLAUDE_<UPPER>, ANTHROPIC_<UPPER>, OPENAI_<UPPER>, CODEX_<UPPER>,
#     GEMINI_<UPPER>, COPILOT_<UPPER> (env vars like CLAUDE_CODE_USE_BEDROCK,
#     OPENAI_API_KEY, CODEX_HOME, GEMINI_API_KEY)
#   - .claude / .claude/ (config dir)
#   - @anthropic-ai/*, @openai/* (package names)
#   - claude-opus-*/claude-sonnet-*/claude-haiku-*, gpt-*, o<N>-*, gemini-* (model ids)
#   - codex-subscription/codex-apikey and other codex-* runtime/identifier names
#   - forge claude / forge codex (forge subcommands wrapping the CLIs)
#   - `claude` / `codex` in backticks (literal binary names)
#   - --claude / --codex (CLI flags)
#   - bare lowercase "claude"/"codex" (CLI tool names; capitalized forms still caught)
# These show up in nearly every forge commit. After stripping, what's left is prose
# mentions, which are the actual rule target.
if grep -v '^[[:space:]]*#' "$MSG_FILE" \
   | sed -E '
       s|@anthropic-ai/?[a-zA-Z0-9_-]*||g
       s|@openai/?[a-zA-Z0-9_-]*||g
       s/CLAUDE\.md//g
       s/CLAUDE_[A-Z_]+//g
       s/ANTHROPIC_[A-Z_]+//g
       s/OPENAI_[A-Z_]+//g
       s/CODEX_[A-Z_]+//g
       s/GEMINI_[A-Z_]+//g
       s/COPILOT_[A-Z_]+//g
       s|\.claude(/[a-zA-Z0-9_/-]*)?||g
       s/claude-(code|opus|sonnet|haiku)[a-z0-9._-]*//g
       s/gpt-[a-z0-9._-]*//g
       s/gemini-[a-z0-9._-]*//g
       s/(^|[^a-zA-Z0-9])o[0-9][a-z0-9._-]*//g
       s/codex-(subscription|apikey)[a-z0-9._-]*//g
       s/codex-[a-z0-9._-]*//g
       s/forge[[:space:]]+claude//g
       s/forge[[:space:]]+codex//g
       s/`claude`//g
       s/`codex`//g
       s/--claude//g
       s/--codex//g
       s/(^|[^a-zA-Z])claude([^a-zA-Z]|$)/\1\2/g
       s/(^|[^a-zA-Z])claude([^a-zA-Z]|$)/\1\2/g
       s/(^|[^a-zA-Z])codex([^a-zA-Z]|$)/\1\2/g
       s/(^|[^a-zA-Z])codex([^a-zA-Z]|$)/\1\2/g
     ' \
   | grep -qiE '\b(claude|anthropic|codex|openai|chatgpt|gemini|copilot)\b'; then
  printf '\033[31m✗ commit blocked:\033[0m commit message mentions "Claude", "Anthropic", "Codex", "OpenAI", "ChatGPT", "Gemini", or "Copilot" in prose.\n' >&2
  printf '  See seeds/constraints/no-ai-attribution.md.\n' >&2
  printf '  (Technical identifiers like CLAUDE.md, OPENAI_API_KEY, CODEX_HOME, GEMINI_API_KEY, .claude/, claude-opus-*, gpt-*, gemini-*, `claude`, `codex`, --claude, forge codex, @openai/* are allowed.)\n' >&2
  printf '  To bypass: git commit --no-verify  (rare; only when the prose reference is intentional)\n' >&2
  exit 1
fi

exit 0
