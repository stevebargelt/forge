{
  "name": "forge",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript CLI for orchestrating multi-agent AI workflows on a personal machine",
  "type": "module",
  "bin": {
    "forge": "./bin/forge",
    "forge-dev": "./bin/forge-dev"
  },
  "scripts": {
    "forge": "tsx src/cli/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p .",
    "test": "npm run test:unit",
    "test:unit": "node --import tsx --import ./src/test-setup.ts --test $(find src -name '*.test.ts' -not -name '*.integration.test.ts' -not -name '*.worktree.test.ts' -not -name 'test-setup.ts' -type f)",
    "test:integration": "bash scripts/run-integration-tests.sh",
    "test:integration:timings": "node --import tsx scripts/measure-integration-timings.ts",
    "test:worktree": "node --import tsx --import ./src/test-setup.ts --test $(find src -name '*.worktree.test.ts' -type f)",
    "test:extended": "npm run test:integration && npm run test:worktree && npm run test:integration -w dashboard",
    "test:all": "npm test && npm test -w dashboard"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "commander": "^12.1.0",
    "gray-matter": "^4.0.3",
    "ws": "^8.21.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.9.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "sharp": "^0.34.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": "^24"
  },
  "workspaces": [
    "dashboard"
  ]
}
